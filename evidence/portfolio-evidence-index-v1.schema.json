{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/h00w/model-quality-release-gate/main/evidence/portfolio-evidence-index-v1.schema.json",
  "title": "Production AI Portfolio Evidence Index v1",
  "type": "object",
  "required": ["schemaVersion", "portfolio", "projects"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "portfolio": {"type": "string"},
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "repository",
          "commit",
          "proof",
          "bundle",
          "distribution",
          "attestations"
        ],
        "properties": {
          "repository": {"type": "string"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "proof": {
            "type": "object",
            "required": ["level", "label"],
            "properties": {
              "level": {"type": "integer", "minimum": 0, "maximum": 5},
              "label": {"type": "string"}
            }
          },
          "bundle": {
            "type": "object",
            "required": ["sha256", "artifactName"],
            "properties": {
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "artifactName": {"type": "string"}
            }
          },
          "distribution": {"type": "object"},
          "attestations": {"type": "object"}
        }
      }
    }
  }
}
